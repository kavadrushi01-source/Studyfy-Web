# Copy to apps/api/.env and apps/web/.env.local — never commit the real files.
# See STUDYFY_PROJECT_SPEC.md §1 and §20 for what each of these is for.

# --- apps/api/.env — free, needed for Phase 0/1 ---
DATABASE_URL=mysql://user:pass@host:port/studyfy
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud_name>
FRONTEND_ORIGIN=http://localhost:3000
SMTP_HOST=                         # Brevo: smtp-relay.brevo.com (free, 300/day)
SMTP_PORT=587
SMTP_USER=                         # Brevo login email
SMTP_PASS=                         # Brevo SMTP key (never commit the real one)
SMTP_FROM=                         # verified sender; defaults to SMTP_USER

# --- AI (Phase 3) — free, build for real on Groq, no card needed ---
GROQ_API_KEY=
GROQ_MODEL=              # optional override — defaults to the single model in src/lib/groq.ts
OPENAI_API_KEY=          # optional future upgrade only — leave blank, never required

# --- Razorpay (Phase 2) — TEST MODE ONLY, permanently, by design (spec
# §1, §13.8). Free to generate, no real money, no business verification
# needed. NEVER put LIVE keys here — including from any other real/live
# project you may have. A live key in this project is a security
# incident, not a convenience: ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- the one deliberately deferred paid feature — leave BLANK until you
# decide to pay for a real gateway (spec §1); the feature stays stubbed
# without this, and should not crash with it unset: ---
SMS_WHATSAPP_API_KEY=

# --- Phase 4 (spec §12.4, §13.11, §16.1) ---
CRON_SECRET=             # long random string (32+ chars); the scheduler sends it as X-Cron-Secret
DEMO_PASSWORD=           # REQUIRED on production (host env vars + password manager — never committed,
                         # never pasted into chat). Local dev may omit it ONLY with NODE_ENV=development
                         # (documented Demo@1234 fallback); anything else without it refuses to seed.
                         # Rotate live demo passwords WITHOUT touching data:
                         #   npm run db:reset-demo-passwords --workspace=@studyfy/api
PLATFORM_GSTIN=          # leave blank while this is a portfolio project; never invent one
PLATFORM_STATE=          # decides CGST+SGST vs IGST on invoices

REDIS_URL=               # later, only once actually needed — not Phase 0/1

# --- apps/web/.env.local ---
NEXT_PUBLIC_API_URL=http://localhost:4000
