{
  "name": "studyfy",
  "version": "0.1.0",
  "private": true,
  "description": "Studyfy — multi-tenant School Management System (see STUDYFY_PROJECT_SPEC.md)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "dev:api": "npm run dev --workspace=@studyfy/api",
    "dev:web": "npm run dev --workspace=@studyfy/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "npm run db:seed --workspace=@studyfy/api"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "eslint": "^9.12.0",
    "prisma": "^6.12.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.0"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
