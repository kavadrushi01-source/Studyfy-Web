// Studyfy core schema — spec §9.1, full pass (Phase 0).
// Conventions:
// - Prisma names are PascalCase/camelCase and match SECURITY_PATTERNS.md's
//   TENANT_MODELS list exactly, so the tenant-scoping extension covers them.
// - DB identifiers are snake_case via @map/@@map (spec text says school_id).
// - Every tenant-scoped model has schoolId + @@index([schoolId, ...]) with
//   school_id FIRST (§9.2 left-prefix rule). Add new tenant models to
//   TENANT_MODELS in the SAME commit (RULES.md §3).
// - roles/permissions/role_permissions are GLOBAL (no school_id, §9.1 note).
// - auth_tokens has no school_id: it is looked up by token_hash globally
//   before any tenant context exists (same reason as TENANT_MODELS omits it).
// - Deliberately NOT here yet (phases that use them): subscriptions,
//   subscription_invoices, tickets, ticket_messages (Phase 4 chunks 2+4).
//   audit_logs landed in Phase 4 Chunk 1 (§13.10) with schools.isDemo/plan
//   (§13.11/§16.1).
// - Deletes default to RESTRICT (no onDelete: Cascade on school children):
//   suspension retains data (§13.4/§16), nothing cascade-deletes a school.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  // Grace after a missed payment (§16.1): 7 days, full access plus a
  // banner. Added in Phase 4 Chunk 2 — the request-time gate and the
  // billing-cycle job both understand it from this commit.
  PAST_DUE
  SUSPENDED
}

// Paid plan tier (§16.1, Phase 4). NULL = no paid plan (trial or
// pre-billing). The single plan definition (price/caps/features) lives in
// one shared config in code (Chunk 2) — this column only records WHICH
// tier, never the tier's details. Seed demo schools carry theirs
// (DEMO_DATA.md: SOS PREMIUM, Ramakrishna STANDARD).
enum SchoolPlan {
  BASIC
  STANDARD
  PREMIUM
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  // REFUNDED exists from day one so Phase 2 refunds need no schema rework
  // (§13.8 "plan for refunds now").
  REFUNDED
}

// Subscription-invoice lifecycle (§16.1, Phase 4 Chunk 2): deliberately
// SMALLER than the fee-invoice one — a school bill is either awaiting
// payment or settled. No partial online payments here (the order flow
// charges the exact outstanding); no overdue state (lateness lives on the
// subscription as PAST_DUE, not on the paper).
enum SubscriptionInvoiceStatus {
  PENDING
  PAID
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  RAZORPAY
}

// Provider-side lifecycle of one money movement (§13.8). Rows are
// CAPTURED at creation — manual counter money and confirmed webhooks
// alike. PENDING/FAILED belong to the order attempt and REFUNDED to the
// refund path; all are Phase 2 webhook transitions, never hand-edited.
enum FeePaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

enum NoticeTarget {
  SCHOOL
  CLASS
  SECTION
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
  SET_PASSWORD
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
}

// Who produced an exam remark (§7 Phase 3 #18): an AI draft from the Groq
// wrapper, or a teacher's own words. No other source may write remarks.
enum RemarkSource {
  AI
  TEACHER
}

// ---------------------------------------------------------------------------
// Tenant root + identity
// ---------------------------------------------------------------------------

model School {
  id                 String             @id @default(cuid()) @map("id")
  name               String             @map("name")
  // Unique at DB level; registration appends a suffix on collision (§9.1).
  slug               String             @unique @map("slug")
  logoUrl            String?            @map("logo_url")
  address            String?            @map("address")
  city               String?            @map("city")
  state              String?            @map("state")
  // Per-school theme color, injected as --school-primary (§12.6).
  // SOS teal vs Ramakrishna maroon makes tenants visually unmistakable.
  brandColor         String?            @map("brand_color")
  phone              String?            @map("phone")
  email              String?            @map("email")
  // IANA timezone; business-day boundaries convert UTC -> this (§12.7).
  // Defaults to Asia/Kolkata for the initial market, editable in setup.
  timezone           String             @default("Asia/Kolkata") @map("timezone")
  // Library fine policy (§7 #13): flat rupees per overdue day, set by the
  // school (default ₹5). Read with the loans board, changed from the
  // library settings block. Whole rupees keep the math exact.
  libraryFinePerDay  Int                @default(5) @map("library_fine_per_day")
  // Exists from Phase 0 for tenantMiddleware's subscription gate (§13.4);
  // the billing UI to manage it is Phase 4. Every registration => TRIAL.
  subscriptionStatus SubscriptionStatus @default(TRIAL) @map("subscription_status")
  // Phase 4 Chunk 1 (§13.11/§16.1): demo-school marker + paid plan tier.
  // isDemo switches on the demo-only behaviors (billing exemption,
  // outbound-mail suppression, nightly-reset eligibility); plan mirrors
  // the subscriptions row and is written ONLY by the billing module
  // (same transaction, §16.1) — never hand-edited elsewhere.
  isDemo           Boolean    @default(false) @map("is_demo")
  plan             SchoolPlan? @map("plan")
  // Registration sets this to now + 14 days (spec §8.3's trial promise).
  // No DB default: creation code MUST supply it, so it can't be forgotten.
  trialEndsAt        DateTime           @map("trial_ends_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  users               User[]
  academicYears       AcademicYear[]
  subjects            Subject[]
  classes             Class[]
  sections            Section[]
  students            Student[]
  studentGuardians    StudentGuardian[]
  staff               Staff[]
  teacherSubjects     TeacherSubject[]
  attendance          Attendance[]
  feeStructures       FeeStructure[]
  feeInvoices         FeeInvoice[]
  feePayments         FeePayment[]
  exams               Exam[]
  examSubjects        ExamSubject[]
  marks               Mark[]
  examRemarks         ExamRemark[]
  timetableSlots      TimetableSlot[]
  homework            Homework[]
  homeworkSubmissions HomeworkSubmission[]
  notices             Notice[]
  enquiries           Enquiry[]
  enquiryNotes        EnquiryNote[]
  certificates        Certificate[]
  books               Book[]
  bookLoans           BookLoan[]
  vehicles            Vehicle[]
  transportRoutes     TransportRoute[]
  studentRoutes       StudentRoute[]
  staffAttendances    StaffAttendance[]
  leaveRequests       LeaveRequest[]
  payrolls            Payroll[]
  documents           Document[]
  messages            Message[]
  biometricDevices    BiometricDevice[]
  inventoryItems      InventoryItem[]
  inventoryMovements  InventoryMovement[]
  auditLogs           AuditLog[]
  subscription        Subscription?
  subscriptionInvoices SubscriptionInvoice[]

  @@map("schools")
}

model User {
  id           String   @id @default(cuid()) @map("id")
  // NULLABLE: NULL means exactly one thing — a Platform Owner account (§9.1).
  // Every other role requires a school_id.
  schoolId     String?  @map("school_id")
  school       School?  @relation(fields: [schoolId], references: [id])
  roleId       String   @map("role_id")
  role         Role     @relation(fields: [roleId], references: [id])
  // Per-school uniqueness: two schools may independently use the same email.
  // NOTE: MySQL treats NULLs as distinct, so this constraint does NOT stop
  // duplicate owner emails — Platform Owner creation (seed/manual only,
  // §13.4) must check email uniqueness among NULL-school rows in code.
  email        String   @map("email")
  passwordHash String   @map("password_hash")
  name         String   @map("name")
  phone        String?  @map("phone")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  studentProfile   Student?
  staffProfile     Staff?
  guardianLinks    StudentGuardian[] @relation("GuardianLinks")
  createdNotices   Notice[]          @relation("NoticeAuthor")
  receivedPayments FeePayment[]      @relation("PaymentReceiver")
  authTokens       AuthToken[]
  refreshTokens    RefreshToken[]
  documents        Document[]
  sentMessages     Message[]         @relation("MessageSender")
  receivedMessages Message[]         @relation("MessageReceiver")
  assignedEnquiries Enquiry[]        @relation("EnquiryAssignee")
  enquiryNotes      EnquiryNote[]    @relation("EnquiryNoteAuthor")
  issuedCertificates Certificate[]   @relation("CertificateIssuer")
  issuedLoans       BookLoan[]       @relation("LoanIssuer")
  inventoryMovements InventoryMovement[]
  auditActions       AuditLog[]        @relation("AuditActor")
  auditImpersonations AuditLog[]       @relation("AuditImpersonator")

  @@unique([schoolId, email])
  @@index([schoolId])
  @@map("users")
}

// GLOBAL tables — seeded once, never per-school (§9.1 fifth note).
model Role {
  id          String   @id @default(cuid()) @map("id")
  // PLATFORM_OWNER, SCHOOL_ADMIN, TEACHER, ACCOUNTANT, STUDENT, PARENT,
  // LIBRARIAN, TRANSPORT_MANAGER (last two used from Phase 2).
  name        String   @unique @map("name")
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid()) @map("id")
  // e.g. "students.read", "attendance.mark", "fees.collect".
  key         String   @unique @map("key")
  description String?  @map("description")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  role         Role   @relation(fields: [roleId], references: [id])
  permissionId String @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Academics structure
// ---------------------------------------------------------------------------

model AcademicYear {
  id        String   @id @default(cuid()) @map("id")
  schoolId  String   @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id])
  name      String   @map("name")
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")

  classes        Class[]
  feeStructures  FeeStructure[]
  exams          Exam[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("academic_years")
}

model Subject {
  id       String @id @default(cuid()) @map("id")
  schoolId String @map("school_id")
  school   School @relation(fields: [schoolId], references: [id])
  // Seeded from spec §3's default list on school setup, editable after.
  name     String @map("name")
  group    String @default("Core") @map("group")

  examSubjects   ExamSubject[]
  timetableSlots TimetableSlot[]
  homework       Homework[]
  teacherSubjects TeacherSubject[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("subjects")
}

model Class {
  id             String        @id @default(cuid()) @map("id")
  schoolId       String        @map("school_id")
  school         School        @relation(fields: [schoolId], references: [id])
  academicYearId String?       @map("academic_year_id")
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  name           String        @map("name")

  sections      Section[]
  feeStructures FeeStructure[]
  notices       Notice[]      @relation("ClassNotices")

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("classes")
}

model Section {
  id       String @id @default(cuid()) @map("id")
  schoolId String @map("school_id")
  school   School @relation(fields: [schoolId], references: [id])
  classId  String @map("class_id")
  class    Class  @relation(fields: [classId], references: [id])
  name     String @map("name")
  // Class teacher: lightweight assignment answering "which teacher owns
  // this section" (attendance marking, teacher roster scoping) — NOT the
  // full period-by-period timetable (§9.1 note, spec v3.2 update).
  classTeacherId String? @map("class_teacher_id")
  classTeacher   Staff?  @relation("ClassTeacher", fields: [classTeacherId], references: [id])

  students       Student[]
  attendance     Attendance[]
  timetableSlots TimetableSlot[]
  homework       Homework[]
  notices        Notice[]      @relation("SectionNotices")

  @@unique([classId, name])
  @@index([schoolId])
  @@map("sections")
}

model Student {
  id          String   @id @default(cuid()) @map("id")
  schoolId    String   @map("school_id")
  school      School   @relation(fields: [schoolId], references: [id])
  userId      String   @unique @map("user_id")
  user        User     @relation(fields: [userId], references: [id])
  sectionId   String   @map("section_id")
  section     Section  @relation(fields: [sectionId], references: [id])
  admissionNo String?  @map("admission_no")
  rollNumber  Int?     @map("roll_number")
  // Device-side ID (biometric/RFID enrollment number, §7 Phase 3 #21).
  // Nullable: unmapped pupils coexist (MySQL treats NULLs as distinct);
  // unique per school once assigned, so a punch resolves to one pupil.
  deviceUserId String? @map("device_user_id")
  dob         DateTime? @map("dob") @db.Date
  gender      String?  @map("gender")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  guardianLinks StudentGuardian[]
  attendance    Attendance[]
  feeInvoices   FeeInvoice[]
  marks         Mark[]
  examRemarks   ExamRemark[]
  submissions   HomeworkSubmission[]
  certificates  Certificate[]
  bookLoans     BookLoan[]
  routes        StudentRoute[]

  @@index([schoolId, sectionId])
  @@unique([schoolId, deviceUserId])
  @@map("students")
}

// Join table — NOT a single parent_id on students: a student can have 2+
// guardians and one guardian can have children in different sections (§9.1).
model StudentGuardian {
  id           String @id @default(cuid()) @map("id")
  schoolId     String @map("school_id")
  school       School @relation(fields: [schoolId], references: [id])
  studentId    String @map("student_id")
  student      Student @relation(fields: [studentId], references: [id])
  parentId     String @map("parent_user_id")
  parent       User   @relation("GuardianLinks", fields: [parentId], references: [id])
  relationship String @default("Guardian") @map("relationship")

  @@unique([studentId, parentId])
  @@index([schoolId])
  @@index([parentId])
  @@map("student_guardians")
}

model Staff {
  id           String   @id @default(cuid()) @map("id")
  schoolId     String   @map("school_id")
  school       School   @relation(fields: [schoolId], references: [id])
  userId       String   @unique @map("user_id")
  user         User     @relation(fields: [userId], references: [id])
  employeeId   String?  @map("employee_id")
  designation  String   @default("Teacher") @map("designation")
  qualification String? @map("qualification")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  markedAttendance Attendance[]    @relation("AttendanceMarker")
  homeworkGiven    Homework[]      @relation("HomeworkTeacher")
  timetableSlots   TimetableSlot[] @relation("SlotTeacher")
  classSections    Section[]       @relation("ClassTeacher")
  teacherSubjects  TeacherSubject[]
  attendances      StaffAttendance[]
  leaveRequests    LeaveRequest[]
  payrolls         Payroll[]

  @@index([schoolId])
  @@map("staff")
}

// ---------------------------------------------------------------------------
// Teacher qualifications (§9.1 note): which subjects each teacher may be
// scheduled to teach. Consumed by the Timetable generator (Chunk 3) and by
// Messaging's teaching-relationship scope (§13.7, Chunk 4). Tenant-scoped
// like everything else — TeacherSubject ∈ TENANT_MODELS (same commit).
// ---------------------------------------------------------------------------

model TeacherSubject {
  id        String  @id @default(cuid()) @map("id")
  schoolId  String  @map("school_id")
  school    School  @relation(fields: [schoolId], references: [id])
  staffId   String  @map("staff_id")
  staff     Staff   @relation(fields: [staffId], references: [id])
  subjectId String  @map("subject_id")
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@unique([staffId, subjectId])
  @@index([schoolId])
  @@map("teacher_subjects")
}

// ---------------------------------------------------------------------------
// Attendance (§9.2: composite index school first; normalized rows, §9.3)
// ---------------------------------------------------------------------------

model Attendance {
  id         String           @id @default(cuid()) @map("id")
  schoolId   String           @map("school_id")
  school     School           @relation(fields: [schoolId], references: [id])
  studentId  String           @map("student_id")
  student    Student          @relation(fields: [studentId], references: [id])
  sectionId  String           @map("section_id")
  section    Section          @relation(fields: [sectionId], references: [id])
  date       DateTime         @map("date") @db.Date
  status     AttendanceStatus @default(PRESENT) @map("status")
  markedById String?          @map("marked_by")
  markedBy   Staff?           @relation("AttendanceMarker", fields: [markedById], references: [id])
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@unique([studentId, date])
  @@index([schoolId, sectionId, date])
  @@map("attendance")
}

// ---------------------------------------------------------------------------
// Fees (§9.2 index; §13.8 idempotency fields for Phase 2 Razorpay)
// ---------------------------------------------------------------------------

model FeeStructure {
  id             String        @id @default(cuid()) @map("id")
  schoolId       String        @map("school_id")
  school         School        @relation(fields: [schoolId], references: [id])
  classId        String        @map("class_id")
  class          Class         @relation(fields: [classId], references: [id])
  academicYearId String?       @map("academic_year_id")
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  name           String        @map("name")
  amount         Decimal       @map("amount") @db.Decimal(10, 2)
  // Which billing period this belongs to ("Term 1", "Annual"…) — the
  // invoice/ reminder flow groups by it. Optional: one-off charges skip it.
  term           String?       @map("term")
  // TUITION / TRANSPORT / LAB / EXAM / ACTIVITY / OTHER. Drives receipt
  // line-labels and category reports; constrained in code, not enum, so a
  // school can introduce a category without a migration.
  category       String        @default("TUITION") @map("category")
  description    String?       @map("description")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  invoices FeeInvoice[]

  @@unique([classId, name])
  @@index([schoolId])
  @@map("fee_structures")
}

model FeeInvoice {
  id          String        @id @default(cuid()) @map("id")
  schoolId    String        @map("school_id")
  school      School        @relation(fields: [schoolId], references: [id])
  studentId   String        @map("student_id")
  student     Student       @relation(fields: [studentId], references: [id])
  structureId String?       @map("structure_id")
  structure   FeeStructure? @relation(fields: [structureId], references: [id])
  amount      Decimal       @map("amount") @db.Decimal(10, 2)
  amountPaid  Decimal       @default(0) @map("amount_paid") @db.Decimal(10, 2)
  status      InvoiceStatus @default(PENDING) @map("status")
  dueDate     DateTime      @map("due_date") @db.Date
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  // Last reminder email sent (UTC instant). Compared in the SCHOOL's
  // calendar day (§12.7): at most one reminder per invoice per local day,
  // so the daily run can't spam a family for the same bill.
  lastReminderAt DateTime?  @map("last_reminder_at")

  payments FeePayment[]

  @@index([schoolId, studentId, status, dueDate])
  @@map("fee_invoices")
}

model FeePayment {
  id       String @id @default(cuid()) @map("id")
  schoolId String @map("school_id")
  school   School @relation(fields: [schoolId], references: [id])
  invoiceId String @map("invoice_id")
  invoice  FeeInvoice @relation(fields: [invoiceId], references: [id])
  amount   Decimal @map("amount") @db.Decimal(10, 2)
  method   PaymentMethod @default(CASH) @map("method")
  // Razorpay ids (§13.8): redelivered webhooks must not double-record.
  // BOTH ids are unique so a repeat order or payment id is a no-op
  // (P2002) instead of a second row. Nullable for manual counter
  // payments (MySQL allows multiple NULLs in unique columns). The
  // Phase 2 webhook resolves the invoice through these ids
  // (findPaymentByProviderId) — never from ids embedded in the payload.
  razorpayOrderId   String? @unique @map("razorpay_order_id")
  razorpayPaymentId String? @unique @map("razorpay_payment_id")
  status            FeePaymentStatus @default(CAPTURED) @map("status")
  receivedById String? @map("received_by")
  receivedBy   User?   @relation("PaymentReceiver", fields: [receivedById], references: [id])
  paidAt     DateTime @default(now()) @map("paid_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([schoolId, invoiceId])
  @@map("fee_payments")
}

// ---------------------------------------------------------------------------
// Exams & gradebook (normalized rows, §9.3)
// ---------------------------------------------------------------------------

model Exam {
  id             String        @id @default(cuid()) @map("id")
  schoolId       String        @map("school_id")
  school         School        @relation(fields: [schoolId], references: [id])
  academicYearId String?       @map("academic_year_id")
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  name           String        @map("name")
  startDate      DateTime?     @map("start_date") @db.Date
  endDate        DateTime?     @map("end_date") @db.Date
  createdAt      DateTime      @default(now()) @map("created_at")

  examSubjects ExamSubject[]
  remarks      ExamRemark[]

  @@index([schoolId])
  @@map("exams")
}

model ExamSubject {
  id        String    @id @default(cuid()) @map("id")
  schoolId  String    @map("school_id")
  school    School    @relation(fields: [schoolId], references: [id])
  examId    String    @map("exam_id")
  exam      Exam      @relation(fields: [examId], references: [id])
  subjectId String    @map("subject_id")
  subject   Subject   @relation(fields: [subjectId], references: [id])
  maxMarks  Decimal   @default(100) @map("max_marks") @db.Decimal(6, 2)
  examDate  DateTime? @map("exam_date") @db.Date

  marks Mark[]

  @@unique([examId, subjectId])
  @@index([schoolId])
  @@map("exam_subjects")
}

model Mark {
  id            String      @id @default(cuid()) @map("id")
  schoolId      String      @map("school_id")
  school        School      @relation(fields: [schoolId], references: [id])
  examSubjectId String      @map("exam_subject_id")
  examSubject   ExamSubject @relation(fields: [examSubjectId], references: [id])
  studentId     String      @map("student_id")
  student       Student     @relation(fields: [studentId], references: [id])
  marksObtained Decimal?    @map("marks_obtained") @db.Decimal(6, 2)
  grade         String?     @map("grade")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@unique([examSubjectId, studentId])
  @@index([schoolId, studentId])
  @@map("marks")
}

// ---------------------------------------------------------------------------
// Exam remarks (§7 Phase 3 #18): one row per report-card remark, written by
// a teacher or drafted by the Groq wrapper (RemarkSource.AI). AI drafts land
// reviewed=false and a teacher flips them after reading — unreviewed AI text
// must never reach a report card unsigned. Multiple rows per pupil per exam
// are allowed (re-drafts); newest first wins. Tenant-scoped — ExamRemark ∈
// TENANT_MODELS (same commit).
// ---------------------------------------------------------------------------

model ExamRemark {
  id          String       @id @default(cuid()) @map("id")
  schoolId    String       @map("school_id")
  school      School       @relation(fields: [schoolId], references: [id])
  studentId   String       @map("student_id")
  student     Student      @relation(fields: [studentId], references: [id])
  examId      String       @map("exam_id")
  exam        Exam         @relation(fields: [examId], references: [id])
  remark      String       @map("remark") @db.Text
  // AI = Groq draft (reviewed=false until a teacher signs off);
  // TEACHER = a teacher's own words. Defaults to TEACHER: AI rows are
  // always stamped explicitly by the generation endpoint, never by default.
  generatedBy RemarkSource @default(TEACHER) @map("generated_by")
  reviewed    Boolean      @default(false) @map("reviewed")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([schoolId, studentId])
  @@index([schoolId, examId])
  @@map("exam_remarks")
}

// ---------------------------------------------------------------------------
// Timetable (§11 graph coloring consumes this; unique slot per section)
// ---------------------------------------------------------------------------

model TimetableSlot {
  id        String  @id @default(cuid()) @map("id")
  schoolId  String  @map("school_id")
  school    School  @relation(fields: [schoolId], references: [id])
  sectionId String  @map("section_id")
  section   Section @relation(fields: [sectionId], references: [id])
  subjectId String  @map("subject_id")
  subject   Subject @relation(fields: [subjectId], references: [id])
  teacherId String  @map("teacher_id")
  teacher   Staff   @relation("SlotTeacher", fields: [teacherId], references: [id])
  // 1 = Monday .. 7 = Sunday (school-timezone day, §12.7).
  dayOfWeek Int    @map("day_of_week")
  period    Int    @map("period")
  startTime String? @map("start_time")
  endTime   String? @map("end_time")

  @@unique([sectionId, dayOfWeek, period])
  @@index([schoolId, sectionId])
  @@map("timetable_slots")
}

// ---------------------------------------------------------------------------
// Homework
// ---------------------------------------------------------------------------

model Homework {
  id          String   @id @default(cuid()) @map("id")
  schoolId    String   @map("school_id")
  school      School   @relation(fields: [schoolId], references: [id])
  sectionId   String   @map("section_id")
  section     Section  @relation(fields: [sectionId], references: [id])
  subjectId   String   @map("subject_id")
  subject     Subject  @relation(fields: [subjectId], references: [id])
  teacherId   String   @map("teacher_id")
  teacher     Staff    @relation("HomeworkTeacher", fields: [teacherId], references: [id])
  title       String   @map("title")
  description String   @map("description") @db.Text
  dueDate     DateTime @map("due_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  submissions HomeworkSubmission[]

  @@index([schoolId, sectionId, dueDate])
  @@map("homework")
}

model HomeworkSubmission {
  id         String           @id @default(cuid()) @map("id")
  schoolId   String           @map("school_id")
  school     School           @relation(fields: [schoolId], references: [id])
  homeworkId String           @map("homework_id")
  homework   Homework         @relation(fields: [homeworkId], references: [id])
  studentId  String           @map("student_id")
  student    Student          @relation(fields: [studentId], references: [id])
  content    String?          @map("content") @db.Text
  // Optional attached file (Cloudinary, same schools/{schoolId}/ folders
  // + whitelist as admission documents — enforced in the route, not here).
  fileUrl    String?          @map("file_url") @db.Text
  status     SubmissionStatus @default(SUBMITTED) @map("status")
  submittedAt DateTime        @default(now()) @map("submitted_at")

  @@unique([homeworkId, studentId])
  @@index([schoolId, homeworkId])
  @@map("homework_submissions")
}

// ---------------------------------------------------------------------------
// Notices
// ---------------------------------------------------------------------------

model Notice {
  id         String       @id @default(cuid()) @map("id")
  schoolId   String       @map("school_id")
  school     School       @relation(fields: [schoolId], references: [id])
  title      String       @map("title")
  body       String       @map("body") @db.Text
  target     NoticeTarget @default(SCHOOL) @map("target")
  classId    String?      @map("class_id")
  class      Class?       @relation("ClassNotices", fields: [classId], references: [id])
  sectionId  String?      @map("section_id")
  section    Section?     @relation("SectionNotices", fields: [sectionId], references: [id])
  createdById String      @map("created_by")
  createdBy  User         @relation("NoticeAuthor", fields: [createdById], references: [id])
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@index([schoolId, createdAt])
  @@map("notices")
}

// ---------------------------------------------------------------------------
// Auth tokens — DB-backed, SINGLE-USE (§13.3). Never an in-memory Map:
// consume (set consumed_at / delete) on first use and reject reuse.
// ---------------------------------------------------------------------------

model AuthToken {
  id         String        @id @default(cuid()) @map("id")
  userId     String        @map("user_id")
  user       User          @relation(fields: [userId], references: [id])
  type       AuthTokenType @map("type")
  // Store only the hash (sha256 hex); the raw token goes to the user once.
  tokenHash  String        @unique @map("token_hash")
  expiresAt  DateTime      @map("expires_at")
  consumedAt DateTime?     @map("consumed_at")
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([userId])
  @@map("auth_tokens")
}

// ---------------------------------------------------------------------------
// Admission enquiries — public intake for the Phase 2 CRM pipeline (§7 #16).
// Submitted WITHOUT auth (like register), always for one school identified
// by slug. Tenant-scoped on reads (admin sees own school's pipeline);
// creation uses the raw client since no JWT exists yet. Added to
// TENANT_MODELS in the same commit (RULES.md §3).
// ---------------------------------------------------------------------------

model Enquiry {
  id        String   @id @default(cuid()) @map("id")
  schoolId  String   @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id])
  name      String   @map("name")
  phone     String?  @map("phone")
  email     String?  @map("email")
  message   String   @map("message") @db.Text
  status    String   @default("NEW") @map("status")
  // Pipeline ownership (Phase 2 CRM §7 #16): which staffer is working this
  // enquiry. Null = unassigned queue.
  assigneeId String? @map("assignee_id")
  assignee   User?   @relation("EnquiryAssignee", fields: [assigneeId], references: [id])
  notes     EnquiryNote[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([schoolId, status, createdAt])
  @@index([schoolId, createdAt])
  @@map("enquiries")
}

// Follow-up log for one enquiry (Phase 2 CRM §7 #16): calls, visits,
// status moves (recorded as notes by the API so the timeline tells the
// whole story). Authors are staff; never shown publicly.
model EnquiryNote {
  id        String   @id @default(cuid()) @map("id")
  schoolId  String   @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id])
  enquiryId String   @map("enquiry_id")
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id")
  author    User     @relation("EnquiryNoteAuthor", fields: [authorId], references: [id])
  body      String   @map("body") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([enquiryId, createdAt])
  @@map("enquiry_notes")
}

// Issued certificates (Phase 2 §7 #17): one row per issuance with a
// human-meaningful serial (CERT/<year>/<per-school sequence>) and a
// frozen payload snapshot, so re-downloads years later print exactly
// what was issued even if the pupil's record changed since.
// ---------------------------------------------------------------------------
// Library (§7 Phase 2 #13): book catalog + issue/return loans. Copies are
// tracked with an availableCopies counter maintained transactionally on
// issue/return (never negative — the 409 path proves it). Overdue is
// derived (dueAt passed + not returned), never stored, so it can't rot.
// Tenant-scoped like any other school data (RULES.md §3).
// ---------------------------------------------------------------------------

model Book {
  id              String     @id @default(cuid()) @map("id")
  schoolId        String     @map("school_id")
  school          School     @relation(fields: [schoolId], references: [id])
  title           String     @map("title")
  author          String     @map("author")
  isbn            String?    @map("isbn")
  category        String     @default("General") @map("category")
  totalCopies     Int        @map("total_copies")
  availableCopies Int        @map("available_copies")
  loans           BookLoan[]
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@index([schoolId, title])
  @@index([schoolId, category])
  @@map("books")
}

// ---------------------------------------------------------------------------
// Transport (§7 Phase 2 #14): bus routes with ordered stops, vehicles with
// drivers, and pupil assignments. A pupil rides at most one stop
// (@@unique on student). Tenant-scoped like any other school data
// (RULES.md §3).
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Transport (§7 Phase 2 #14, founder schema): fleet-level vehicles,
// routes carrying their stops as an ordered JSON run, and a join table
// mapping pupils onto routes — a pupil rides or doesn't, term to term
// (row presence IS the subscription; one active ride per pupil).
// ---------------------------------------------------------------------------

model Vehicle {
  id                 String   @id @default(cuid()) @map("id")
  schoolId           String   @map("school_id")
  school             School   @relation(fields: [schoolId], references: [id])
  registrationNumber String   @map("registration_number")
  capacity           Int      @map("capacity")
  driverName         String   @map("driver_name")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, registrationNumber])
  @@map("vehicles")
}

model TransportRoute {
  id        String         @id @default(cuid()) @map("id")
  schoolId  String         @map("school_id")
  school    School         @relation(fields: [schoolId], references: [id])
  name      String         @map("name")
  stops     Json           @map("stops")
  riders    StudentRoute[]
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@index([schoolId, name])
  @@map("transport_routes")
}

model StudentRoute {
  id        String         @id @default(cuid()) @map("id")
  schoolId  String         @map("school_id")
  school    School         @relation(fields: [schoolId], references: [id])
  studentId String         @map("student_id")
  student   Student        @relation(fields: [studentId], references: [id])
  routeId   String         @map("route_id")
  route     TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@unique([schoolId, studentId])
  @@index([routeId])
  @@map("student_routes")
}

// ---------------------------------------------------------------------------
// Payroll (§7 Phase 2 #15, basic): monthly salary structures per staffer +
// generated month rows flipped PENDING → PAID. Records only — no money
// moves here. Amounts are Decimal-exact strings end to end (§13.6).
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Payroll (§7 Phase 2 #15, founder schema): staff attendance marks,
// leave requests, and computed monthly payroll rows (base − deductions
// = net). Amounts are Decimal-exact strings end to end (§13.6).
// ---------------------------------------------------------------------------

model StaffAttendance {
  id        String           @id @default(cuid()) @map("id")
  schoolId  String           @map("school_id")
  school    School           @relation(fields: [schoolId], references: [id])
  staffId   String           @map("staff_id")
  staff     Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date      DateTime         @map("date") @db.Date
  status    AttendanceStatus @default(PRESENT) @map("status")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@unique([schoolId, staffId, date])
  @@index([schoolId, date])
  @@map("staff_attendance")
}

model LeaveRequest {
  id        String   @id @default(cuid()) @map("id")
  schoolId  String   @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id])
  staffId   String   @map("staff_id")
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dates     Json     @map("dates")
  reason    String   @map("reason") @db.Text
  status    String   @default("PENDING") @map("status")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([schoolId, staffId])
  @@index([schoolId, status])
  @@map("leave_requests")
}

model Payroll {
  id          String   @id @default(cuid()) @map("id")
  schoolId    String   @map("school_id")
  school      School   @relation(fields: [schoolId], references: [id])
  staffId     String   @map("staff_id")
  staff       Staff    @relation(fields: [staffId], references: [id])
  month       String   @map("month")
  baseSalary  Decimal  @map("base_salary") @db.Decimal(12, 2)
  deductions  Decimal  @map("deductions") @db.Decimal(12, 2)
  netPay      Decimal  @map("net_pay") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, staffId, month])
  @@index([schoolId, month])
  @@map("payroll")
}

model BookLoan {
  id         String    @id @default(cuid()) @map("id")
  schoolId   String    @map("school_id")
  school     School    @relation(fields: [schoolId], references: [id])
  bookId     String    @map("book_id")
  book       Book      @relation(fields: [bookId], references: [id], onDelete: Restrict)
  studentId  String    @map("student_id")
  student    Student   @relation(fields: [studentId], references: [id])
  issuedBy   String    @map("issued_by")
  issuer     User      @relation("LoanIssuer", fields: [issuedBy], references: [id])
  issuedAt   DateTime  @default(now()) @map("issued_at")
  dueAt      DateTime  @map("due_at")
  returnedAt DateTime? @map("returned_at")
  // Rupees owed, frozen at return time (overdue days × the school's rate
  // then in force). Null while out or when returned on time — open loans
  // show a live computation instead, never this column.
  fineAmount Decimal?  @map("fine_amount") @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([schoolId, studentId, returnedAt])
  @@index([bookId, returnedAt])
  @@map("book_loans")
}

model Certificate {
  id        String   @id @default(cuid()) @map("id")
  schoolId  String   @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id])
  studentId String   @map("student_id")
  student   Student  @relation(fields: [studentId], references: [id])
  type      String   @map("type")
  serial    String   @map("serial")
  payload   Json     @map("payload")
  issuedBy  String   @map("issued_by")
  issuer    User     @relation("CertificateIssuer", fields: [issuedBy], references: [id])
  // Stored artifact (founder direction): the issued PDF is uploaded once
  // and kept as a documents row (type CERTIFICATE); downloads serve the
  // stored bytes, never a regeneration. Null for rows issued before this
  // existed (or where storage was unconfigured, e.g. local dev) — those
  // fall back to regenerating from the snapshot.
  documentId String?  @map("document_id")
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([schoolId, serial])
  @@index([schoolId, studentId, createdAt])
  @@map("certificates")
}

// ---------------------------------------------------------------------------
// Documents — uploaded admission files and ID-card photos (Phase 1 SIS).
// Deferred in Phase 0 per AGENT_START_HERE.md; needed now. Spec §9.1:
// owner_id FK + cloudinary_url + type. §13.5: files live under a
// `schools/{schoolId}/...` Cloudinary folder with non-guessable public IDs
// (enforced in the upload endpoint, not the schema — the schema stores the
// final URL). Tenant-scoped like any other school data.
// ---------------------------------------------------------------------------

model Document {
  id        String   @id @default(cuid()) @map("id")
  schoolId  String   @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id])
  ownerId   String   @map("owner_id")
  owner     User     @relation(fields: [ownerId], references: [id])
  url       String   @map("cloudinary_url") @db.Text
  type      String   @map("type")
  createdAt DateTime @default(now()) @map("created_at")
  certificates Certificate[]

  @@index([schoolId, ownerId])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Refresh tokens — opaque, DB-backed, ROTATED (§2: 7d httpOnly cookie).
// Each token is single-use: /refresh consumes it (revoked_at + replaced_by)
// and issues the next. Presenting an already-rotated token means theft —
// the whole chain is revoked. Global lookup by hash (never tenant-scoped,
// same as auth_tokens — do NOT add to TENANT_MODELS).
// ---------------------------------------------------------------------------

model RefreshToken {
  id          String    @id @default(cuid()) @map("id")
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id])
  // sha256 hex of the opaque token; the raw value lives only in the cookie.
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  replacedBy  String?   @map("replaced_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Messages — 1:1 academic chat (§7 Phase 1 #8, §13.7). Deferred from Phase 0
// (no messaging without the access rules below). threadId is a deterministic
// pair key (sorted user ids) so a conversation lists with one indexed
// lookup. Tenant-scoped — Message ∈ TENANT_MODELS (same commit).
// Who may talk to whom lives in messages.service.ts, not here.
// ---------------------------------------------------------------------------

model Message {
  id         String   @id @default(cuid()) @map("id")
  schoolId   String   @map("school_id")
  school     School   @relation(fields: [schoolId], references: [id])
  senderId   String   @map("sender_id")
  sender     User     @relation("MessageSender", fields: [senderId], references: [id])
  receiverId String   @map("receiver_id")
  receiver   User     @relation("MessageReceiver", fields: [receiverId], references: [id])
  threadId   String   @map("thread_id")
  body       String   @map("body") @db.Text
  readAt     DateTime? @map("read_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([schoolId, threadId, createdAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Biometric/RFID devices (§7 Phase 3 #21): a registry of physical
// attendance terminals, one row per unit. Punches arrive on the key-authed
// import endpoint (machine actor, never a JWT) carrying device-side user
// IDs, which resolve to pupils through Student.deviceUserId. The device
// key itself is shown ONCE at registration and stored only as a sha256
// hash — a leaked database never yields a working device key.
// Tenant-scoped — BiometricDevice ∈ TENANT_MODELS (same commit).
// ---------------------------------------------------------------------------

model BiometricDevice {
  id           String    @id @default(cuid()) @map("id")
  schoolId     String    @map("school_id")
  school       School    @relation(fields: [schoolId], references: [id])
  name         String    @map("name")
  location     String?   @map("location")
  // sha256 hex of the device API key; the raw key exists only in the
  // registration response, never in a column.
  apiKeyHash   String    @unique @map("api_key_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastSyncAt   DateTime? @map("last_sync_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([schoolId, isActive])
  @@map("biometric_devices")
}

// ---------------------------------------------------------------------------
// Inventory (§7 Phase 3 #22): school stock (stationery, lab supplies,
// sports gear). Quantities move only through movement rows — the item
// counter is maintained transactionally on stock-in/out and never goes
// negative (the 409 path proves it), same discipline as library copies.
// Low stock is derived (quantity <= reorder level), never stored.
// Tenant-scoped — both models ∈ TENANT_MODELS (same commit).
// ---------------------------------------------------------------------------

model InventoryItem {
  id           String   @id @default(cuid()) @map("id")
  schoolId     String   @map("school_id")
  school       School   @relation(fields: [schoolId], references: [id])
  name         String   @map("name")
  sku          String?  @map("sku")
  category     String   @default("General") @map("category")
  unit         String   @default("pcs") @map("unit")
  quantity     Int      @default(0) @map("quantity")
  reorderLevel Int      @default(0) @map("reorder_level")
  movements    InventoryMovement[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, name])
  @@index([schoolId, category])
  @@map("inventory_items")
}

model InventoryMovement {
  id        String   @id @default(cuid()) @map("id")
  schoolId  String   @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id])
  itemId    String   @map("item_id")
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  // IN adds, OUT subtracts. No ADJUST type: corrections are explicit
  // IN/OUT rows with a reason, so history always explains the counter.
  type      String   @map("type")
  quantity  Int      @map("quantity")
  reason    String?  @map("reason") @db.Text
  createdBy String   @map("created_by")
  creator   User     @relation(fields: [createdBy], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@index([schoolId, itemId, createdAt])
  @@map("inventory_movements")
}

// ---------------------------------------------------------------------------
// Subscription & billing (§7 Phase 4 #24, §16.1, Chunk 2): how schools pay
// Studyfy. (Parents paying schools is Phase 2 Razorpay — a different flow
// on different tables; the only thing they share is the §13.8 order +
// webhook shape, extended here, never a second gateway integration.)
//
// Single-writer rule (§16.1): ONLY the billing module writes
// schools.subscriptionStatus and schools.plan — they MIRROR the
// subscriptions row and update in the same transaction. Status flow:
// TRIAL → ACTIVE → PAST_DUE → SUSPENDED, reversible on payment. Read the
// mirror, never the row, anywhere outside billing/.
// Tenant-scoped — both models ∈ TENANT_MODELS (same commit).
// ---------------------------------------------------------------------------

model Subscription {
  id                 String             @id @default(cuid()) @map("id")
  schoolId           String             @unique @map("school_id")
  school             School             @relation(fields: [schoolId], references: [id])
  plan               SchoolPlan         @map("plan")
  status             SubscriptionStatus @default(TRIAL) @map("status")
  // The paid period this row covers. NULL on trial rows (trial length comes
  // from schools.trialEndsAt — one source of truth, never two).
  currentPeriodStart DateTime?          @map("current_period_start") @db.Date
  currentPeriodEnd   DateTime?          @map("current_period_end") @db.Date
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@map("subscriptions")
}

model SubscriptionInvoice {
  id          String                    @id @default(cuid()) @map("id")
  schoolId    String                    @map("school_id")
  school      School                    @relation(fields: [schoolId], references: [id])
  // Sequential per financial year (April–March), from an atomic counter
  // incremented in the SAME transaction that creates the invoice (never
  // count()+1 — two invoices created at once would collide). UNIQUE at the
  // DB level. Short by GST rules. While this is a portfolio project every
  // invoice prints "TEST INVOICE — not a tax invoice" (§16.1).
  invoiceNumber String                   @unique @map("invoice_number")
  // Financial year the number belongs to ("2026-27") — display + counter key.
  financialYear String                   @map("financial_year")
  // Integer paise, rounded once, never floats (§16.1, §13.6). GST is 18% on
  // top of the plan price: same-state splits CGST 9% + SGST 9%, otherwise
  // IGST 18% — exactly one of the pairs is nonzero, always.
  amountPaise Int                      @map("amount_paise")
  cgstPaise   Int                      @default(0) @map("cgst_paise")
  sgstPaise   Int                      @default(0) @map("sgst_paise")
  igstPaise   Int                      @default(0) @map("igst_paise")
  status      SubscriptionInvoiceStatus @default(PENDING) @map("status")
  // What the invoice covers.
  periodStart DateTime                 @map("period_start") @db.Date
  periodEnd   DateTime                 @map("period_end") @db.Date
  // Online payment linkage (§16.1: the SHARED §13.8 order + webhook flow,
  // looked up by order id across fee_payments THEN subscription_invoices —
  // never a second gateway product). NULL until the school pays online.
  razorpayOrderId   String?            @unique @map("razorpay_order_id")
  razorpayPaymentId String?            @unique @map("razorpay_payment_id")
  paidAt        DateTime?              @map("paid_at")
  // MANUAL (owner marks paid) or RAZORPAY (online, test mode). Test/manual
  // payments are labelled as such on every revenue surface (§16.1).
  paidMethod    String?                @map("paid_method")
  createdAt     DateTime               @default(now()) @map("created_at")

  @@index([schoolId, status, createdAt])
  @@map("subscription_invoices")
}

// Billing counters — GLOBAL table (no school_id), like roles/permissions:
// one row per financial year, bumped atomically inside the invoice-creation
// transaction. Deliberately NOT in TENANT_MODELS (nothing to scope).
model BillingCounter {
  financialYear String @id @map("financial_year")
  lastNumber    Int    @default(0) @map("last_number")

  @@map("billing_counters")
}

// ---------------------------------------------------------------------------
// Audit logs (§7 Phase 4 #25, §13.10): the platform's memory. Impersonation,
// billing, suspension and exports all write here from day one through the
// single audit.record() helper (same transaction as the change where
// possible). APPEND-ONLY: no update/delete route, service method, or UI —
// not for School Admin, not for the Platform Owner.
// - schoolId NULLABLE: NULL means a platform-level action (e.g. owner
//   login). The tenant extension then hides those rows from every school —
//   exactly the fail-closed behavior §9.1 wants.
// - before/after are built from per-entity field ALLOWLISTS in audit.ts,
//   never by serializing a whole row: hashes, keys and secrets never land
//   in a log row. A missing allowlist throws instead of logging everything.
// - Ordinary reads are NOT logged (noise); exports and impersonation are
//   the exceptions. Retention: decide before the hot table fills the ~1GB
//   free DB (Chunk 5 close-out at the latest).
// Tenant-scoped — AuditLog ∈ TENANT_MODELS (same commit).
// ---------------------------------------------------------------------------

model AuditLog {
  id              String    @id @default(cuid()) @map("id")
  schoolId        String?   @map("school_id")
  school          School?   @relation(fields: [schoolId], references: [id])
  // NULLABLE: NULL means an external-system actor — the Razorpay webhook
  // captures money with no user behind it (§13.8), and no honest user id
  // exists to attribute. Human actors always pass their id. (Tenant
  // reads resolve names only for same-school actors; cross-actor display
  // belongs to the Super Admin panel, Chunk 3.)
  actorId         String?   @map("actor_id")
  // Restrict (not SetNull): audit rows must outlive their actors — deleting
  // a user who has audit history fails instead of silently orphaning it.
  // No user-deletion path exists today; this keeps it that way.
  actor           User?     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  // Non-null while impersonating (§13.9): who is actually behind the wheel.
  impersonatedBy  String?   @map("impersonated_by")
  impersonator    User?     @relation("AuditImpersonator", fields: [impersonatedBy], references: [id])
  action          String    @map("action")
  entity          String    @map("entity")
  entityId        String?   @map("entity_id")
  before          Json?     @map("before")
  after           Json?     @map("after")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([schoolId, createdAt])
  @@index([schoolId, entity, createdAt])
  @@map("audit_logs")
}
